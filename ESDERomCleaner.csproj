<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ApplicationIcon>chip-smd-8bit.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Ship only the native LibVLC engine matching this Windows x64 application. -->
    <VlcWindowsX64Enabled>true</VlcWindowsX64Enabled>
    <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
    <VlcWindowsArm64Enabled>false</VlcWindowsArm64Enabled>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.1.5</Version>
  </PropertyGroup>

  <!-- Credenciales de desarrollador de ScreenScraper: se leen de DevCredentials.props (local, ignorado por git; ver DevCredentials.props.example)
       o de las variables de entorno SS_DEVID, SS_DEVPASSWORD y SS_SOFTNAME, y se incrustan en el exe como metadatos del ensamblado (en claro: no es cifrado). -->
  <Import Project="DevCredentials.props" Condition="Exists('DevCredentials.props')" />
  <PropertyGroup>
    <SsDevId Condition="'$(SsDevId)' == ''">$(SS_DEVID)</SsDevId>
    <SsDevPassword Condition="'$(SsDevPassword)' == ''">$(SS_DEVPASSWORD)</SsDevPassword>
    <SsSoftName Condition="'$(SsSoftName)' == ''">$(SS_SOFTNAME)</SsSoftName>
  </PropertyGroup>
  <ItemGroup Condition="'$(SsDevId)' != '' And '$(SsDevPassword)' != ''">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ssd</_Parameter1>
      <_Parameter2>$(SsDevId)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ssp</_Parameter1>
      <_Parameter2>$(SsDevPassword)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>sss</_Parameter1>
      <_Parameter2>$(SsSoftName)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Entrega_ESDERomCleaner\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="7-Zip.CommandLine" Version="25.1.0" GeneratePathProperty="true" ExcludeAssets="all" />
    <PackageReference Include="LibVLCSharp.WinForms" Version="3.10.1" />
    <PackageReference Include="SharpCompress" Version="0.50.5" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.12" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.23.1" />
  </ItemGroup>

  <!-- 7-Zip incorporado (7za.exe, de línea de comandos) para crear archivos .7z sin depender de que esté instalado. Licencia LGPL: se incluye su texto. -->
  <ItemGroup>
    <None Include="$(Pkg7-Zip_CommandLine)\tools\x64\7za.exe" Link="7z\7za.exe" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(Pkg7-Zip_CommandLine)\tools\License.txt" Link="7z\License.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\SystemIcons\*.png" LogicalName="SystemIcons.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>