<Project>
  <!-- Copia este archivo como DevCredentials.props (está en .gitignore) y rellena los datos que te dio ScreenScraper.
       Alternativa: variables de entorno SS_DEVID, SS_DEVPASSWORD y SS_SOFTNAME. -->
  <PropertyGroup>
    <SsDevId>tu_devid</SsDevId>
    <SsDevPassword>tu_clave_de_desarrollador</SsDevPassword>
    <SsSoftName>ESDERomCleaner</SsSoftName>
  </PropertyGroup>
</Project>
